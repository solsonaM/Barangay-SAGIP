APP_NAME="Barangay SAGIP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barangay_sagip
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database

MAIL_MAILER=log

# --- Barangay SAGIP: ML microservice ---
# Points to the FastAPI service in /ml-service. Run it separately with:
#   uvicorn main:app --host 0.0.0.0 --port 8001
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TIMEOUT=5
