# Copy to .env next to docker-compose.production.yml on the deployment host.
# Never commit the real values.
POSTGRES_DB=barangay_sagip
POSTGRES_USER=barangay_sagip
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
TOKENIZATION_SERVICE_KEY=REPLACE_WITH_A_LONG_RANDOM_SERVICE_KEY
APP_HTTP_PORT=8080
TOKENIZATION_CONFIDENCE_THRESHOLD=0.45
TOKENIZATION_ASSIGNMENT_MIN_SCORE=0.35
TOKENIZATION_ASSIGNMENT_MIN_MARGIN=0.05
TOKENIZATION_RULESET_VERSION=1.0.0
